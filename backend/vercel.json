{
  "version": 2,
  "builds": [
    {
      "src": "api/index.js",
      "use": "@vercel/node"
    }
  ],
  "routes": [
    {
      "src": "/(.*)",
      "dest": "api/index.js"
    }
  ],
  "crons": [
    {
      "path": "/api/cron/auto-rotate",
      "schedule": "*/1 * * * *"
    },
    {
      "path": "/api/cron/order-cleanup",
      "schedule": "*/1 * * * *"
    }
  ]
}