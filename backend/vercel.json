{
  "version": 2,
  "routes": [
    {
      "src": "/memberInvite(.*)",
      "dest": "/api/index.js"
    }
  ],
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": "/api/index.js"
    }
  ],
  "crons": [
    {
      "path": "/api/cron/auto-rotate",
      "schedule": "0 0 * * *"
    },
    {
      "path": "/api/cron/order-cleanup",
      "schedule": "0 0 * * *"
    }
  ]
}