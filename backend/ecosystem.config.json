{
  "name": "TpayX-backend",
  "script": "src/server.js",
  "instances": 1,
  "autorestart": true,
  "watch": false,
  "max_memory_restart": "300M",
  "env_production": {
    "NODE_ENV": "production",
    "PORT": 5000
  },
  "error_file": "/www/wwwroot/TpayX-backend/logs/error.log",
  "out_file": "/www/wwwroot/TpayX-backend/logs/out.log",
  "log_date_format": "YYYY-MM-DD HH:mm:ss"
}

